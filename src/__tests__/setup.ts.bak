/**
 * M0 — Configuração de testes base.
 * Vitest + jsdom. Sem dependências externas ainda.
 */
import "@testing-library/jest-dom";

// Extensão para window.matchMedia
if (typeof window !== "undefined") {
  ;(window as any).matchMedia =
    (window as any).matchMedia ||
    function (query: string) {
      return {
        matches: false,
        media: query,
        onchange: null,
        addListener: function (this: any, handler: any) {
          this.onchange = handler;
        },
        removeListener: function (this: any, handler: any) {
          this.removeListener = handler;
        },
        addEventListener: function (
          this: any,
          event: string,
          handler: any,
        ) {
          this.addEventListener = handler;
        },
        removeEventListener: function (
          this: any,
          event: string,
          handler: any,
        ) {
          this.removeEventListener = handler;
        },
        dispatchEvent: function (this: any, event: any) {
          this.dispatchEvent = event;
        },
      };
    };
}